rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/expenses/{expenseId} {
      function owner() {
        return request.auth != null && request.auth.uid == userId;
      }
      function validExpense() {
        let d = request.resource.data;
        return d.keys().hasAll(['userId', 'title', 'amount', 'category', 'date', 'createdAt', 'updatedAt'])
          && d.keys().hasOnly(['userId', 'title', 'amount', 'category', 'date', 'note', 'createdAt', 'updatedAt'])
          && d.userId == userId
          && d.title is string && d.title.matches('.*\\S.*')
          && d.amount is number && d.amount > 0 && d.amount <= 1.7976931348623157e308
          && d.category in ['food', 'transport', 'shopping', 'bills', 'entertainment', 'health', 'education', 'travel', 'other']
          && d.date is timestamp && d.createdAt is timestamp && d.updatedAt is timestamp
          && (!('note' in d) || d.note == null || d.note is string)
          && d.updatedAt >= d.createdAt;
      }
      allow read: if owner();
      allow create: if owner() && validExpense()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if owner() && resource.data.userId == userId && validExpense()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if owner() && resource.data.userId == userId;
    }
  }
}
